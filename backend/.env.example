# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Leave empty to use local SQLite. On Render use the Postgres "Internal Database URL".
DATABASE_URL=

# Secret for the hourly inactivity check (GitHub Actions sends it)
CRON_SECRET=change-me-cron-secret

# Admin account created by `python manage.py ensure_admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# WhatsApp Cloud API (sandbox from developers.facebook.com -> WhatsApp -> API Setup)
WHATSAPP_ACCESS_TOKEN=your_test_token
PHONE_NUMBER_ID=your_test_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# Email: Resend
# Without a verified domain keep onboarding@resend.dev; it can only send to your Resend account email.
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Web Push (OneSignal)
ONESIGNAL_APP_ID=your_app_id
ONESIGNAL_REST_API_KEY=your_api_key
DEFAULT_COUNTRY_CODE=91
